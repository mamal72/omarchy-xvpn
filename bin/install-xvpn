#!/usr/bin/env bash
set -euo pipefail

official_source="https://app.xvpncdn.com/4dzfjmwrjw/cli_install.sh"
source_value="${1:-$official_source}"
temp_dir=""

cleanup() {
  [[ -z "$temp_dir" ]] || rm -rf -- "$temp_dir"
}
trap cleanup EXIT

case "$source_value" in
  https://*)
    if [[ "$source_value" != "$official_source" ]]; then
      printf 'Remote installer overrides are not allowed. Use the official URL or a local file.\n' >&2
      exit 2
    fi
    temp_dir="$(mktemp -d)"
    installer="$temp_dir/cli_install.sh"
    printf 'Downloading installer from %s\n' "$source_value"
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error "$source_value" --output "$installer"
    ;;
  file://*)
    installer="${source_value#file://}"
    ;;
  /*)
    installer="$source_value"
    ;;
  *)
    printf 'Installer source must be an HTTPS URL, file:// URL, or absolute path.\n' >&2
    exit 2
    ;;
esac

[[ -f "$installer" ]] || { printf 'Installer not found: %s\n' "$installer" >&2; exit 2; }
[[ -r "$installer" ]] || { printf 'Installer is not readable: %s\n' "$installer" >&2; exit 2; }

printf '\nInstaller: %s\n' "$installer"
printf '%s\n' '---------------- installer begins ----------------'
/bin/cat -- "$installer"
printf '%s\n' '----------------- installer ends -----------------'
printf 'Review the script above before continuing. It will request sudo access.\n\n'
read -r -p 'Run the X-VPN installer now? [y/N] ' answer
[[ "$answer" =~ ^[Yy]$ ]] || exit 0

/bin/sh "$installer"
